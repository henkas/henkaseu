---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectDetail from './ProjectDetail.astro';

const allProjects = await getCollection('projects');

// Sort: featured first, then by date descending
const projects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.localeCompare(a.data.date);
});

const featured = projects.find((p) => p.data.featured);
const nonFeatured = projects.filter((p) => !p.data.featured);

// Bento: featured card + up to 4 small cards
const bentoSmall = nonFeatured.slice(0, 4);
// Regular grid: remaining
const remaining = nonFeatured.slice(4);
const categories = [...new Set(projects.map((p) => p.data.category))].sort();
---

<section id="projects" class="projects-section">
  <div class="section-card">
    <!-- Header: label + filter -->
    <div class="projects-header">
      <div class="section-label-group">
        <span class="section-num">02</span>
        <p class="label">Projects</p>
      </div>
      <div class="filter-pills" role="group" aria-label="Filter projects by category">
        <button class="filter-pill filter-pill--active" data-filter="all">All</button>
        {categories.map((cat) => (
          <button class="filter-pill" data-filter={cat}>
            {cat.charAt(0).toUpperCase() + cat.slice(1)}
          </button>
        ))}
      </div>
    </div>

    <!-- Bento grid -->
    {(featured || bentoSmall.length > 0) && (
      <div class="bento-grid" id="bento-grid">
        {featured && (
          <ProjectCard
            title={featured.data.title}
            description={featured.data.description}
            tags={featured.data.tags}
            category={featured.data.category}
            featured={true}
            slug={featured.slug}
            status={featured.data.status}
            links={featured.data.links}
            award={featured.data.award}
          />
        )}
        {bentoSmall.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            category={p.data.category}
            featured={false}
            slug={p.slug}
            status={p.data.status}
            links={p.data.links}
            award={p.data.award}
          />
        ))}
      </div>
    )}

    <!-- Regular grid: remaining projects -->
    {remaining.length > 0 && (
      <div class="regular-grid" id="regular-grid">
        {remaining.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            category={p.data.category}
            featured={false}
            slug={p.slug}
            status={p.data.status}
            links={p.data.links}
            award={p.data.award}
          />
        ))}
      </div>
    )}

    <!-- Empty state when filter matches nothing -->
    <p class="no-match" id="no-match" style="display:none">
      No projects in this category yet.
    </p>
  </div>
</section>

<!-- Build-time project detail dialogs -->
{allProjects.map((entry) => (
  <dialog id={`modal-${entry.slug}`} class="project-dialog">
    <button class="dialog-close" aria-label="Close">✕</button>
    <div class="dialog-scroll">
      <ProjectDetail project={entry} isModal={true} />
    </div>
  </dialog>
))}

<script>
  // ── Category filter ────────────────────────────────
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const noMatch = document.getElementById('no-match')!;

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter!;

      pills.forEach((p) => p.classList.remove('filter-pill--active'));
      pill.classList.add('filter-pill--active');

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      noMatch.style.display = visible === 0 ? 'block' : 'none';
    });
  });

  // ── Project modals ─────────────────────────────────

  // Open on card click
  document.querySelectorAll<HTMLAnchorElement>('[data-category]').forEach((card) => {
    card.addEventListener('click', (e) => {
      const href = card.getAttribute('href') ?? '';
      if (!href.startsWith('/projects/')) return;
      e.preventDefault();
      const slug = href.replace('/projects/', '').replace(/\/$/, '');
      const dialog = document.getElementById(`modal-${slug}`) as HTMLDialogElement | null;
      if (!dialog) return;
      dialog.showModal();
      history.pushState({ slug }, '', `/projects/${slug}`);
    });
  });

  // Close via ✕ button
  document.querySelectorAll<HTMLButtonElement>('.dialog-close').forEach((btn) => {
    btn.addEventListener('click', () => {
      (btn.closest('dialog') as HTMLDialogElement).close();
      history.pushState(null, '', '/');
    });
  });

  // Close via backdrop click
  document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close();
        history.pushState(null, '', '/');
      }
    });
  });

  // Close via back link inside modal
  document.querySelectorAll<HTMLAnchorElement>('[data-modal-back]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      (link.closest('dialog') as HTMLDialogElement | null)?.close();
      history.pushState(null, '', '/');
    });
  });

  // Auto-open if page loads at /projects/slug
  const match = location.pathname.match(/^\/projects\/([^/]+)/);
  if (match) {
    const d = document.getElementById(`modal-${match[1]}`) as HTMLDialogElement | null;
    d?.showModal();
  }

  // Browser back closes open dialogs
  window.addEventListener('popstate', () => {
    if (!location.pathname.startsWith('/projects/')) {
      document.querySelectorAll<HTMLDialogElement>('.project-dialog[open]').forEach((d) =>
        d.close()
      );
    }
  });
</script>

<style>
  .projects-section {
    max-width: 900px;
    margin: 20px auto 0;
    padding: 0 20px;
  }

  .projects-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-pills {
    display: flex;
    gap: 6px;
  }

  .filter-pill {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-pill:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .filter-pill--active {
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    border-color: transparent;
    color: #fff;
  }

  /* Bento: featured card spans 2 rows */
  .bento-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }

  /* Regular 3-col grid */
  .regular-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
  }

  .regular-grid > :only-child {
    grid-column: 1 / -1;
  }

  .no-match {
    color: var(--text-muted);
    font-size: 13px;
    text-align: center;
    padding: 24px 0;
  }

  @media (max-width: 800px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr;
    }

    .regular-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 500px) {
    .bento-grid,
    .regular-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
