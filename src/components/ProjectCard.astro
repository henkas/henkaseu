---
interface Props {
  title: string;
  description: string;
  tags: string[];
  category: string;
  featured: boolean;
  slug: string;
  status: string;
  links?: { github?: string; live?: string };
  award?: { name: string; badge?: string };
}

const { title, description, tags, category, featured, slug, status, links, award } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class:list={['project-card', { 'project-card--featured': featured }]}
  data-category={category}
>
  {featured && <span class="featured-badge">Featured</span>}
  {award && (
    <span class="award-badge">
      <svg class="award-swift-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M21.85 7.06c.07.27.13.56.17.84.59 3.8-1.07 8.03-4.79 10.95-.06.05-.14.09-.2.14 .05-.02.13-.06.22-.11 1.55-.86 5.06-3.38 4.3-7.37a6.5 6.5 0 0 0-.36-1.15c-.04-.09-.09-.17-.13-.26-.73-1.46-2.14-2.88-4.02-4.08C13.62 3.7 9.58 2.16 6.03 1.3c0 0 3.68 2.77 5.09 4.54A55.8 55.8 0 0 1 3.66 1 .16.16 0 0 0 3.47 1c-.01.01-.01.04 0 .06 1.88 3.27 4.42 6.81 5.14 7.7-1.78-1-4.8-3.31-6.82-5.34A.12.12 0 0 0 1.61 3.5c.31 1.15.93 2.74 2.04 4.37 1.34 1.98 4.56 5.47 8.86 7.28-2.14.96-4.87.91-7.47-.3.02.03.04.05.07.08 2.06 1.63 4.46 2.5 6.73 2.5 1.95 0 3.79-.65 5.14-1.89l.03-.03c2.68-2.37 3.63-5.81 4.03-7.65.05-.22.08-.42.11-.58.22-1.61.04-2.97-.36-4.11-.03-.1-.07-.19-.11-.29-.02-.03-.03-.06-.04-.09a.1.1 0 0 1 .01.03c.04.08.09.17.12.25z"/></svg>
      {award.name}
    </span>
  )}

  <div class="card-meta">
    <span class="label card-category">{category}</span>
    {status === 'active' && links?.live && <span class="status-dot" title="Active"></span>}
  </div>

  <h3 class="card-title">{title}</h3>

  {featured && (
    <p class="card-desc">{description}</p>
  )}

  <div class="card-tags">
    {tags.slice(0, featured ? 5 : 3).map((t) => (
      <span class="tag">{t}</span>
    ))}
  </div>

  {featured && (
    <div class="card-links">
      {links?.live && (
        <span
          class="card-link-pill"
          onclick={`event.preventDefault(); window.open('${links.live}', '_blank')`}
        >
          Live ↗
        </span>
      )}
      {links?.github && (
        <span
          class="card-link-pill card-link-pill--muted"
          onclick={`event.preventDefault(); window.open('${links.github}', '_blank')`}
        >
          GitHub ↗
        </span>
      )}
      <span class="card-readmore">Read more →</span>
    </div>
  )}
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 18px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
  }

  .project-card--featured {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 22px 24px;
    grid-row: span 2;
  }

  .project-card--featured:hover {
    border-color: var(--accent-light);
  }

  .featured-badge {
    align-self: flex-start;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    border: 1px solid var(--accent);
    padding: 3px 8px;
    border-radius: 20px;
    /* Override gradient clip for border rendering */
    -webkit-text-fill-color: var(--accent-light);
  }

  .award-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #c4b5fd;
    border: 1px solid #6d5dca;
    background: linear-gradient(135deg, rgba(65, 88, 208, 0.15), rgba(139, 92, 246, 0.15));
    padding: 3px 8px;
    border-radius: 20px;
  }

  .award-swift-icon {
    color: #f97316;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-category {
    text-transform: capitalize;
    letter-spacing: 1.5px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--color-active);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.3px;
  }

  .project-card--featured .card-title {
    font-size: 18px;
    letter-spacing: -0.5px;
  }

  .card-desc {
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: auto;
  }

  .card-links {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .card-link-pill {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-light);
    border: 1px solid var(--accent);
    padding: 4px 10px;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .card-link-pill:hover {
    background: var(--accent);
    color: #fff;
  }

  .card-link-pill--muted {
    color: var(--text-secondary);
    border-color: var(--border);
  }

  .card-link-pill--muted:hover {
    background: var(--border);
    color: var(--text-primary);
  }

  .card-readmore {
    font-size: 12px;
    color: var(--text-muted);
    margin-left: auto;
  }
</style>
