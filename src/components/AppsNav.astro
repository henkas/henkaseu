---
import { appsUrl } from '../lib/urls';
---

<header class="apps-nav-wrapper">
  <nav class="apps-nav-inner">
    <a href={appsUrl('/')} class="apps-nav-wordmark">
      <span class="apps-nav-wordmark-base">apps.henkas.eu</span>
    </a>
    <span class="apps-nav-label">Apps by Henki Papp</span>
  </nav>
</header>

<style>
  .apps-nav-wrapper {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding: 0 20px;
    pointer-events: none;
  }

  .apps-nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: #242440cc;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 10px;
    pointer-events: all;
  }

  .apps-nav-wordmark {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.3px;
  }

  .apps-nav-label {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .apps-nav-label {
      display: none;
    }
  }
</style>
