---
import { getCollection, type CollectionEntry } from 'astro:content';
import AppsBase from '../../layouts/AppsBase.astro';
import { appsUrl } from '../../lib/urls';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { appname: app.slug }, props: { app } }));
}

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const { Content } = await app.render();
const { name, tagline, status, platforms, license, links, icon } = app.data;

const statusLabel: Record<string, string> = {
  live: 'Live',
  beta: 'Beta',
  'coming-soon': 'Coming Soon',
};

type StoreKey = 'appStore' | 'googlePlay';
const storeLabels: Record<StoreKey, string> = {
  appStore: 'App Store',
  googlePlay: 'Google Play',
};

const stores: Array<{ key: StoreKey; value: string | undefined }> = [
  { key: 'appStore', value: links?.appStore },
  { key: 'googlePlay', value: links?.googlePlay },
];
---

<AppsBase title={`${name} — Apps by Henki Papp`} description={tagline}>
  <a href={appsUrl('/')} class="detail-back">← All apps</a>

  <header class="detail-header">
    <div class="detail-icon">
      {icon ? (
        <img src={icon} alt={`${name} icon`} />
      ) : (
        <div class="detail-icon-placeholder">{name.slice(0, 1)}</div>
      )}
    </div>

    <div class="detail-head-text">
      <div class="detail-meta-row">
        <span class={`detail-status detail-status--${status}`}>{statusLabel[status]}</span>
        {license && <span class="detail-license">{license}</span>}
      </div>
      <h1 class="detail-title">{name}</h1>
      <p class="detail-tagline">{tagline}</p>
      {platforms.length > 0 && (
        <div class="detail-platforms">
          {platforms.map((p) => <span class="tag">{p}</span>)}
        </div>
      )}
    </div>
  </header>

  <section class="detail-links">
    {stores.map(({ key, value }) => {
      if (!value) return null;
      if (value === 'coming-soon') {
        return (
          <button class="btn-store btn-store--disabled" type="button" disabled>
            <span class="btn-store-label">{storeLabels[key]}</span>
            <span class="btn-store-state">Coming soon</span>
          </button>
        );
      }
      return (
        <a href={value} target="_blank" rel="noopener" class="btn-store">
          <span class="btn-store-label">{storeLabels[key]}</span>
          <span class="btn-store-state">Get it ↗</span>
        </a>
      );
    })}

    {links?.web && (
      <a href={links.web} target="_blank" rel="noopener" class="btn-primary">
        Visit site ↗
      </a>
    )}
    {links?.github && (
      <a href={links.github} target="_blank" rel="noopener" class="btn-ghost">
        Source on GitHub ↗
      </a>
    )}
  </section>

  <article class="detail-content">
    <Content />
  </article>
</AppsBase>

<style>
  .detail-back {
    display: inline-block;
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.15s;
  }

  .detail-back:hover {
    color: var(--text-primary);
  }

  .detail-header {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 28px;
    align-items: center;
    margin-bottom: 36px;
  }

  .detail-icon {
    width: 96px;
    height: 96px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .detail-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-icon-placeholder {
    font-size: 44px;
    font-weight: 700;
    color: var(--accent-light);
    letter-spacing: -1px;
  }

  .detail-head-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .detail-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .detail-status {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 20px;
  }

  .detail-status--live {
    background: color-mix(in srgb, var(--color-active) 18%, transparent);
    color: var(--color-active);
  }

  .detail-status--beta {
    background: color-mix(in srgb, var(--accent-light) 18%, transparent);
    color: var(--accent-light);
  }

  .detail-status--coming-soon {
    background: var(--border);
    color: var(--text-secondary);
  }

  .detail-license {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .detail-title {
    font-size: 36px;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.6px;
    margin: 0;
  }

  .detail-tagline {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .detail-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }

  .detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 24px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 32px;
  }

  .btn-store {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    background: var(--bg-card);
    color: var(--text-primary);
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .btn-store:hover {
    border-color: var(--accent);
    background: var(--bg-hover);
  }

  .btn-store--disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .btn-store--disabled:hover {
    border-color: var(--border);
    background: var(--bg-card);
  }

  .btn-store-label {
    font-size: 13px;
    font-weight: 600;
  }

  .btn-store-state {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .detail-content {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 15px;
  }

  .detail-content :global(p) {
    margin: 0 0 18px;
  }

  .detail-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .detail-content :global(a) {
    color: var(--accent-light);
    text-decoration: underline;
    text-decoration-color: var(--border);
  }

  .detail-content :global(a:hover) {
    text-decoration-color: var(--accent-light);
  }

  @media (max-width: 600px) {
    .detail-header {
      grid-template-columns: 72px 1fr;
      gap: 20px;
    }
    .detail-icon {
      width: 72px;
      height: 72px;
    }
    .detail-icon-placeholder {
      font-size: 32px;
    }
    .detail-title {
      font-size: 28px;
    }
  }
</style>
