---
// Real photos from public/. Column layout preserves every image's native aspect ratio.
// Col A: landscape plane → portrait dog  (total height ≈ 2× col width)
// Col B: portrait dog   → landscape plane (same total height — ratios are inverses)
---

<div id="photography" class="bento-card photo-tile">
  <div class="bento-card-label">Photography</div>
  <div class="photo-masonry">
    <div class="photo-col">
      <img src="/photo-plane.jpg"  alt="Aircraft on approach" class="photo-img" />
      <img src="/photo-pupp2.jpg" alt="Dog close-up"         class="photo-img" />
    </div>
    <div class="photo-col">
      <img src="/photo-puppy.jpg"  alt="Dog with toy"         class="photo-img" />
      <img src="/photo-plane2.jpg" alt="Transavia aircraft"   class="photo-img" />
    </div>
  </div>
  <div class="photo-footer">
    <p class="photo-caption">Pets, skylines, and whatever catches my eye.</p>
    <div class="photo-links">
      <a href="https://photo.henkas.eu" target="_blank" rel="noopener" class="photo-link">
        photo.henkas.eu ↗
      </a>
      <a href="https://instagram.com/henkyfen" target="_blank" rel="noopener" class="photo-link photo-link--ig">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        @henkyfen
      </a>
    </div>
  </div>
</div>

<style>
  .photo-tile {
    display: flex;
    flex-direction: column;
  }

  .photo-masonry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 14px;
  }

  .photo-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* height: auto — the only rule that truly preserves native aspect ratio */
  .photo-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }

  .photo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .photo-caption {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }

  .photo-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .photo-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
    transition: color 0.15s;
  }

  .photo-link:hover { color: var(--text-primary); }

  .photo-link--ig { color: var(--text-muted); }
  .photo-link--ig:hover { color: #e1306c; }
</style>
