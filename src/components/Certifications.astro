---
import { getCollection } from 'astro:content';

const allCerts = await getCollection('certifications');
const certs = allCerts.sort((a, b) => a.data.order - b.data.order);
---

<section id="certifications" class="certs-section">
  <div class="section-card">
    <div class="section-label-group" style="margin-bottom: 20px;">
      <span class="section-num">04</span>
      <p class="label">Certifications</p>
    </div>
    <div class="certs-grid">
      {certs.map((cert) => (
        <div class:list={['surface-card cert-card', { 'cert-card--pending': cert.data.status === 'in-progress' }]}>
          {cert.data.badge_image
            ? <img src={cert.data.badge_image} alt={cert.data.name} class="cert-badge-img" width="48" height="48" />
            : <div class="cert-badge-placeholder"></div>
          }
          <div class="cert-info">
            <p class="cert-name">{cert.data.name}</p>
            <p class="cert-issuer">{cert.data.issuer}</p>
            {cert.data.status === 'active' && cert.data.issued && (
              <p class="cert-issued">{cert.data.issued}</p>
            )}
            {cert.data.status === 'in-progress' && (
              <span class="label cert-pending-label">In progress</span>
            )}
            {cert.data.status === 'active' && cert.data.credly_url && (
              <a href={cert.data.credly_url} target="_blank" rel="noopener" class="btn-ghost cert-verify">
                Verify ↗
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .certs-section {
    max-width: 900px;
    margin: 20px auto 0;
    padding: 0 20px;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 20px;
  }

  .cert-card--pending {
    opacity: 0.55;
  }

  .cert-badge-img {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 6px;
    object-fit: contain;
  }

  .cert-badge-placeholder {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    background: var(--bg-hover);
    border: 1px dashed var(--border);
    border-radius: 6px;
  }

  .cert-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cert-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: 12px;
    color: var(--accent-light);
    margin: 0;
  }

  .cert-issued {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
  }

  .cert-pending-label {
    color: var(--text-dim);
  }

  .cert-verify {
    align-self: flex-start;
    font-size: 11px;
    padding: 4px 10px;
    margin-top: 4px;
  }
</style>
