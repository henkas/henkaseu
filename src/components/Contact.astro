---
const github = 'https://github.com/henkas';
const linkedin = 'https://linkedin.com/in/henkipapp';
---

<div id="contact" class="bento-card bento-span-2 contact-tile">
  <div class="bento-card-label">Contact</div>
  <div class="contact-inner">

    <!-- Left: heading + social links -->
    <div class="contact-left">
      <h2 class="contact-heading">Let's talk.</h2>
      <p class="contact-body">Got a project, idea, or just want to connect — drop me a line.</p>
      <div class="contact-links">
        <a href={`mailto:henkas@henkas.eu`} class="contact-link contact-link--accent">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          henkas@henkas.eu
        </a>
        <a href={github} target="_blank" rel="noopener" class="contact-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          github.com/henkas
        </a>
        <a href={linkedin} target="_blank" rel="noopener" class="contact-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          linkedin.com/in/henkipapp
        </a>
      </div>
    </div>

    <!-- Right: contact form -->
    <form class="contact-form" id="contact-form" novalidate>
      <div class="form-field">
        <label for="cf-email" class="form-label">Your email</label>
        <input
          id="cf-email"
          name="email"
          type="email"
          class="form-input"
          placeholder="you@example.com"
          required
        />
      </div>
      <div class="form-field">
        <label for="cf-subject" class="form-label">Subject</label>
        <input
          id="cf-subject"
          name="subject"
          type="text"
          class="form-input"
          placeholder="What's on your mind?"
          required
        />
      </div>
      <div class="form-field">
        <label for="cf-message" class="form-label">Message</label>
        <textarea
          id="cf-message"
          name="message"
          class="form-input form-textarea"
          placeholder="Tell me more…"
          rows="4"
          required
        ></textarea>
      </div>
      <button type="submit" class="btn-primary form-submit">Send message</button>
    </form>

  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email   = (form.elements.namedItem('email')   as HTMLInputElement).value;
    const subject = (form.elements.namedItem('subject') as HTMLInputElement).value;
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value;
    const body    = `From: ${email}\n\n${message}`;
    window.location.href =
      `mailto:henkas@henkas.eu` +
      `?subject=${encodeURIComponent(subject)}` +
      `&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-tile {
    display: flex;
    flex-direction: column;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 32px;
    flex: 1;
  }

  .contact-left {
    display: flex;
    flex-direction: column;
  }

  .contact-heading {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .contact-body {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .contact-link:hover { color: var(--text-primary); }

  .contact-link--accent {
    color: var(--accent-light);
    font-weight: 600;
  }

  .contact-link--accent:hover { color: var(--text-primary); }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .form-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .form-input {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }

  .form-input::placeholder { color: var(--text-faint); }

  .form-input:focus { border-color: var(--accent); }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-submit {
    align-self: flex-start;
    margin-top: 4px;
  }

  @media (max-width: 1100px) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .contact-links {
      margin-top: 0;
    }
  }
</style>
