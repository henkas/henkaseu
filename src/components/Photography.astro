---
// Real photos from public/
---

<div id="photography" class="bento-card bento-span-2 photo-tile">
  <div class="bento-card-label">Photography</div>
  <div class="photo-grid">
    <img src="/photo-puppy.jpg"  alt="Rat portrait"   class="photo-thumb" />
    <img src="/photo-plane.jpg"  alt="Aerial view"    class="photo-thumb" />
    <img src="/photo-puppy2.jpg" alt="Rat close-up"   class="photo-thumb" />
    <img src="/photo-plane2.jpg" alt="Plane window"   class="photo-thumb" />
  </div>
  <p class="photo-caption">Pets, skylines, and whatever catches my eye.</p>
  <a
    href="https://photo.henkas.eu"
    target="_blank"
    rel="noopener"
    class="photo-link"
  >
    photo.henkas.eu ↗
  </a>
</div>

<style>
  .photo-tile {
    display: flex;
    flex-direction: column;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    flex: 1;
    margin-bottom: 10px;
  }
  .photo-thumb {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 6px;
  }
  .photo-caption {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0 0 8px;
  }
  .photo-link {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
  }
</style>
