---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectDetail from './ProjectDetail.astro';

const allProjects = await getCollection('projects');

const projects = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.localeCompare(a.data.date);
});

const featured = projects.find((p) => p.data.featured);
const nonFeatured = projects.filter((p) => !p.data.featured);
const wideProjects = nonFeatured.filter((p) => p.data.cardLayout === 'wide');
const regularProjects = nonFeatured.filter((p) => p.data.cardLayout !== 'wide');
---

<!-- Anchor for nav -->
<div id="projects" style="display:contents"></div>

<!-- Project cards as direct bento children -->
{featured && (
  <ProjectCard
    title={featured.data.title}
    description={featured.data.description}
    tags={featured.data.tags}
    category={featured.data.category}
    featured={true}
    slug={featured.slug}
    status={featured.data.status}
    links={featured.data.links}
    award={featured.data.award}
    tagline={featured.data.tagline}
    icon={featured.data.icon}
  />
)}
{regularProjects.map((p) => (
  <ProjectCard
    title={p.data.title}
    description={p.data.description}
    tags={p.data.tags}
    category={p.data.category}
    featured={false}
    slug={p.slug}
    status={p.data.status}
    links={p.data.links}
    award={p.data.award}
    tagline={p.data.tagline}
    icon={p.data.icon}
  />
))}
{wideProjects.map((p) => (
  <div class="bento-card wide-project-card bento-span-4" data-category={p.data.category}>
    <div class="wide-project-inner">
      <div class="wide-project-left">
        <div class="wide-project-header">
          {p.data.icon && <img src={p.data.icon} alt={p.data.title} class="wide-project-icon" />}
          <div>
            <p class="label wide-project-category">{p.data.category}</p>
            <h3 class="wide-project-title">{p.data.title}</h3>
          </div>
        </div>
        {p.data.tagline && <p class="wide-project-tagline">{p.data.tagline}</p>}
        <p class="wide-project-desc">{p.data.description}</p>
        <div class="wide-project-tags">
          {p.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        {p.data.links && (
          <div class="wide-project-links">
            {p.data.links.github && (
              <a href={p.data.links.github} target="_blank" rel="noopener" class="wide-project-link">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
            )}
            {p.data.links.live && (
              <a href={p.data.links.live} target="_blank" rel="noopener" class="wide-project-link">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Live
              </a>
            )}
          </div>
        )}
      </div>
      <div class="wide-project-services">
        <div class="service-pill">
          <span class="service-label">Email</span>
          <span class="service-value">Mailcow · SMTP/IMAP · DKIM</span>
        </div>
        <div class="service-pill">
          <span class="service-label">Identity</span>
          <span class="service-value">ZITADEL · OAuth 2.0 · SSO</span>
        </div>
        <div class="service-pill">
          <span class="service-label">Networking</span>
          <span class="service-value">Pangolin · TLS · Reverse Proxy</span>
        </div>
        <div class="service-pill">
          <span class="service-label">Compute</span>
          <span class="service-value">4-node Proxmox · VMs · LXC</span>
        </div>
        <div class="service-pill">
          <span class="service-label">Media</span>
          <span class="service-value">NAS · Local Streaming</span>
        </div>
        <div class="service-pill">
          <span class="service-label">Automation</span>
          <span class="service-value">Ansible · IaC</span>
        </div>
      </div>
    </div>
  </div>
))}

<!-- Modal dialogs (display:none, don't affect grid layout) -->
{allProjects.map((entry) => (
  <dialog id={`modal-${entry.slug}`} class="project-dialog">
    <button class="dialog-close" aria-label="Close">✕</button>
    <div class="dialog-scroll">
      <ProjectDetail project={entry} isModal={true} />
    </div>
  </dialog>
))}

<script>
  // ── Project modals ─────────────────────────────────

  // Open on card click
  document.querySelectorAll<HTMLAnchorElement>('[data-category]').forEach((card) => {
    card.addEventListener('click', (e) => {
      const href = card.getAttribute('href') ?? '';
      if (!href.startsWith('/projects/')) return;
      e.preventDefault();
      const slug = href.replace('/projects/', '').replace(/\/$/, '');
      const dialog = document.getElementById(`modal-${slug}`) as HTMLDialogElement | null;
      if (!dialog) return;
      dialog.showModal();
      history.pushState({ slug }, '', `/projects/${slug}`);
    });
  });

  // Close via button
  document.querySelectorAll<HTMLButtonElement>('.dialog-close').forEach((btn) => {
    btn.addEventListener('click', () => {
      (btn.closest('dialog') as HTMLDialogElement).close();
      history.pushState(null, '', '/');
    });
  });

  // Close via backdrop click
  document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close();
        history.pushState(null, '', '/');
      }
    });
  });

  // Close via back link inside modal
  document.querySelectorAll<HTMLAnchorElement>('[data-modal-back]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      (link.closest('dialog') as HTMLDialogElement | null)?.close();
      history.pushState(null, '', '/');
    });
  });

  // Auto-open if page loads at /projects/slug
  const match = location.pathname.match(/^\/projects\/([^/]+)/);
  if (match) {
    const d = document.getElementById(`modal-${match[1]}`) as HTMLDialogElement | null;
    d?.showModal();
  }

  // Browser back closes open dialogs
  window.addEventListener('popstate', () => {
    if (!location.pathname.startsWith('/projects/')) {
      document.querySelectorAll<HTMLDialogElement>('.project-dialog[open]').forEach((d) =>
        d.close()
      );
    }
  });
</script>

<style>
  /* ── Wide project card (homelab style) ── */
  .wide-project-card {
    cursor: default;
  }

  .wide-project-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 32px;
    align-items: start;
  }

  .wide-project-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wide-project-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wide-project-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .wide-project-category {
    margin: 0 0 4px;
  }

  .wide-project-title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.1;
  }

  .wide-project-tagline {
    font-size: 13px;
    color: var(--accent-light);
    font-weight: 500;
    margin: 0;
  }

  .wide-project-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .wide-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .wide-project-links {
    display: flex;
    gap: 12px;
    margin-top: 4px;
  }

  .wide-project-link {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .wide-project-link:hover {
    color: var(--accent-light);
  }

  /* ── Service pills grid ── */
  .wide-project-services {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    align-content: start;
  }

  .service-pill {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .service-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .service-value {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .wide-project-inner {
      grid-template-columns: 1fr;
    }

    .wide-project-services {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .wide-project-services {
      grid-template-columns: 1fr;
    }
  }
</style>
