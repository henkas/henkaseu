---
import { getCollection } from 'astro:content';

const allCerts = await getCollection('certifications');
const sorted   = allCerts.sort((a, b) => a.data.order - b.data.order);
const completed  = sorted.filter((c) => c.data.status === 'active');
const inProgress = sorted.filter((c) => c.data.status === 'in-progress');
---

<div id="achievements" class="bento-card achievements-tile">
  <div class="bento-card-label">Achievements</div>

  <!-- Completed — large badge cards -->
  <div class="cert-grid">
    {completed.map((cert) => (
      <div class="cert-item">
        {cert.data.badge_image && (
          <img
            src={cert.data.badge_image}
            alt={cert.data.name}
            class="cert-badge-img"
          />
        )}
        <p class="cert-name">{cert.data.name}</p>
        <p class="cert-issuer">
          {cert.data.issuer}{cert.data.issued ? ` · ${cert.data.issued}` : ''}
        </p>
        {cert.data.credly_url && (
          <a href={cert.data.credly_url} target="_blank" rel="noopener" class="cert-verify">
            Verify ↗
          </a>
        )}
      </div>
    ))}
  </div>

  <!-- In progress — compact text rows -->
  {inProgress.length > 0 && (
    <div class="cert-pending-list">
      {inProgress.map((cert) => (
        <div class="cert-pending-item">
          <div class="cert-pending-info">
            <span class="cert-name">{cert.data.name}</span>
            <span class="cert-issuer">{cert.data.issuer}</span>
          </div>
          <span class="cert-pending-badge">In progress</span>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .achievements-tile {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Completed certs ── */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .cert-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 16px 22px;
    transition: border-color 0.15s;
  }

  .cert-item:hover {
    border-color: var(--accent);
  }

  .cert-badge-img {
    width: 160px;
    height: 160px;
    object-fit: contain;
    border-radius: 16px;
  }

  .cert-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: 11px;
    color: var(--accent-light);
    margin: 0;
  }

  .cert-verify {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 12px;
    transition: border-color 0.15s, color 0.15s;
  }

  .cert-verify:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  /* ── In-progress rows ── */
  .cert-pending-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border);
    padding-top: 14px;
  }

  .cert-pending-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    opacity: 0.6;
  }

  .cert-pending-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cert-pending-info .cert-name {
    font-size: 12px;
    text-align: left;
  }

  .cert-pending-info .cert-issuer {
    text-align: left;
  }

  .cert-pending-badge {
    flex-shrink: 0;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 10px;
    white-space: nowrap;
  }
</style>
