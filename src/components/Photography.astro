---
// Real photos from public/
---

<div id="photography" class="bento-card photo-tile">
  <div class="bento-card-label">Photography</div>
  <div class="photo-collage">
    <!-- back row: two landscape planes -->
    <div class="photo-frame photo-frame--2">
      <img src="/photo-plane.jpg" alt="Aircraft on approach" />
    </div>
    <div class="photo-frame photo-frame--4">
      <img src="/photo-plane2.jpg" alt="Transavia aircraft" />
    </div>
    <!-- front row: two portrait dogs, slightly overlapping the planes -->
    <div class="photo-frame photo-frame--1">
      <img src="/photo-puppy.jpg" alt="Dog with toy" />
    </div>
    <div class="photo-frame photo-frame--3">
      <img src="/photo-pupp2.jpg" alt="Dog close-up" />
    </div>
  </div>
  <div class="photo-footer">
    <p class="photo-caption">Pets, skylines, and whatever catches my eye.</p>
    <div class="photo-links">
      <a href="https://photo.henkas.eu" target="_blank" rel="noopener" class="photo-link">
        photo.henkas.eu ↗
      </a>
      <a href="https://instagram.com/henkyfen" target="_blank" rel="noopener" class="photo-link photo-link--ig">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        @henkyfen
      </a>
    </div>
  </div>
</div>

<style>
  .photo-tile {
    display: flex;
    flex-direction: column;
  }

  /* ── Collage ── */
  .photo-collage {
    position: relative;
    height: 290px;
    margin-bottom: 14px;
  }

  .photo-frame {
    position: absolute;
    overflow: hidden;
    border-radius: 6px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: default;
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-frame:hover {
    z-index: 10 !important;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7);
  }

  /* Landscape planes — sit in the back, anchored to top */
  .photo-frame--2 {
    width: 54%;
    height: 155px;
    top: 0;
    right: 0;
    transform: rotate(2deg);
    z-index: 1;
  }
  .photo-frame--2:hover { transform: rotate(2deg) scale(1.04); }

  .photo-frame--4 {
    width: 50%;
    height: 148px;
    top: 18px;
    left: 0;
    transform: rotate(-1.5deg);
    z-index: 2;
  }
  .photo-frame--4:hover { transform: rotate(-1.5deg) scale(1.04); }

  /* Portrait dogs — sit in front, anchored to bottom, crop shows face */
  .photo-frame--1 {
    width: 42%;
    height: 170px;
    bottom: 0;
    left: 4%;
    transform: rotate(-3deg);
    z-index: 3;
  }
  .photo-frame--1 img { object-position: center 20%; }
  .photo-frame--1:hover { transform: rotate(-3deg) scale(1.05); }

  .photo-frame--3 {
    width: 44%;
    height: 178px;
    bottom: 4px;
    right: 3%;
    transform: rotate(2.5deg);
    z-index: 4;
  }
  .photo-frame--3 img { object-position: center 20%; }
  .photo-frame--3:hover { transform: rotate(2.5deg) scale(1.05); }

  /* ── Footer ── */
  .photo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .photo-caption {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }

  .photo-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .photo-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
    transition: color 0.15s;
  }

  .photo-link:hover { color: var(--text-primary); }

  .photo-link--ig { color: var(--text-muted); }
  .photo-link--ig:hover { color: #e1306c; }
</style>
